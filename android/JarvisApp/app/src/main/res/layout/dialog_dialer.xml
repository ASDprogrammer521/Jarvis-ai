<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_sheet"
    android:paddingHorizontal="22dp"
    android:paddingTop="14dp"
    android:paddingBottom="22dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_input" />

    <TextView
        android:id="@+id/dialNumber"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:hint="Enter number"
        android:textColor="@color/text"
        android:textColorHint="@color/muted"
        android:textSize="32sp"
        android:singleLine="true"
        android:ellipsize="start" />

    <TextView
        android:id="@+id/dialHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Tap Call to redial the last number"
        android:textColor="@color/muted"
        android:textSize="12sp" />

    <GridLayout
        android:id="@+id/keypad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:columnCount="3" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/dialPaste"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Paste"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />
        <ImageButton
            android:id="@+id/dialCall"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_call_green"
            android:src="@drawable/ic_call"
            android:scaleType="centerInside"
            android:padding="22dp"
            android:contentDescription="Call" />
        <ImageButton
            android:id="@+id/dialBack"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@null"
            android:src="@drawable/ic_backspace"
            android:scaleType="centerInside"
            android:contentDescription="Delete" />
    </LinearLayout>
</LinearLayout>
